<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pomiary wydajności (BenchmarkDotNet). Zwykły program konsolowy, nie projekt testowy —
    dotnet test go pomija, a CI buduje go razem z rozwiązaniem, żeby kod pomiarów nie zgnił.
    Uruchamianie: docs/BENCHMARKS.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameTranslatorOverlay.Core\GameTranslatorOverlay.Core.csproj" />
    <ProjectReference Include="..\..\src\GameTranslatorOverlay.Infrastructure\GameTranslatorOverlay.Infrastructure.csproj" />
  </ItemGroup>

</Project>
