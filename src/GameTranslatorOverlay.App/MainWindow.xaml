<Window x:Class="GameTranslatorOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTranslatorOverlay"
        Width="1020"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="#FF14181C"
        Foreground="White"
        FontSize="13">
  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" Background="#FF0E1114" CornerRadius="6" Padding="10,5" Margin="0,8,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="TxtStatus" Text="Gotowy." Foreground="#FFB0BEC5" />
        <TextBlock x:Name="TxtCounters" DockPanel.Dock="Right" Foreground="#FF78909C" />
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,10,0,0"
               FontSize="11"
               Foreground="#FF607D8B"
               TextWrapping="Wrap"
               Text="GameTranslatorOverlay to zewnętrzna nakładka tłumacząca obraz widoczny na ekranie. Program nie modyfikuje gry, jej plików ani procesu i nie gwarantuje zgodności z regulaminem każdej gry — sprawdź zasady danej gry przed użyciem. Projekt nie jest powiązany z twórcami obsługiwanych gier. Przy tłumaczeniu online rozpoznany tekst jest wysyłany do zewnętrznego API (np. DeepL)." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock Text="Uruchomione okna" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
          <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="Odśwież" Click="OnRefreshClick" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnCapture" Content="📷 Podgląd okna" Click="OnCaptureClick" />
            <Button x:Name="BtnOcrTest" Content="🔎 OCR podglądu" Click="OnOcrTestClick" Margin="8,0,0,0" />
          </StackPanel>
          <Border Margin="0,8,0,0" Background="#FF0E1114" CornerRadius="6" Height="205">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" />
          </Border>
        </StackPanel>

        <ListBox x:Name="WindowsList"
                 Margin="0,8"
                 Background="#FF0E1114"
                 Foreground="White"
                 BorderThickness="0"
                 DisplayMemberPath="DisplayName"
                 SelectionChanged="OnWindowSelectionChanged" />
      </DockPanel>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Tłumaczenie" FontWeight="SemiBold" FontSize="14" />

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Język źródłowy:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbSourceLang" Margin="0,3" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Język docelowy:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="0" Grid.Column="4" x:Name="CmbTargetLang" Margin="0,3" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dostawca tłumaczeń:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbProvider" Margin="0,3" SelectionChanged="OnSettingChanged" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Profil gry:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="1" Grid.Column="4" x:Name="CmbProfile" Margin="0,3" SelectionChanged="OnSettingChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Wyświetlanie wyniku:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbDisplayMode" Margin="0,3" SelectionChanged="OnSettingChanged" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Rozmiar czcionki (0 = jak oryginał):" VerticalAlignment="Center" Margin="0,3" FontSize="12" />
            <TextBox Grid.Row="2" Grid.Column="4" x:Name="TxtFontSize" Margin="0,3" LostFocus="OnSettingChanged" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Położenie dymków:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbPlacement" Margin="0,3" SelectionChanged="OnSettingChanged" />
            <TextBlock Grid.Row="3" Grid.Column="3" Text="Tło dymków:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="3" Grid.Column="4" x:Name="CmbBackground" Margin="0,3" SelectionChanged="OnSettingChanged" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Krój czcionki:" VerticalAlignment="Center" Margin="0,3" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbFont" Margin="0,3" SelectionChanged="OnSettingChanged" />
          </Grid>

          <GroupBox Header="Klucz API (DeepL)" Foreground="White" Margin="0,10,0,0" Padding="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <PasswordBox x:Name="PwdApiKey" Width="330" />
                <Button Content="Zapisz klucz" Click="OnSaveKeyClick" Margin="8,0,0,0" />
                <Button Content="Testuj" Click="OnTestKeyClick" Margin="6,0,0,0" />
                <Button Content="Usuń" Click="OnDeleteKeyClick" Margin="6,0,0,0" />
              </StackPanel>
              <TextBlock x:Name="TxtKeyStatus" Foreground="#FF90A4AE" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock Foreground="#FF546E7A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Klucz jest szyfrowany przez Windows (DPAPI) i nie opuszcza tego komputera. Darmowy klucz DeepL kończy się na „:fx”. Bez klucza możesz używać dostawcy „Mock” do testów." />
            </StackPanel>
          </GroupBox>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="ChkCacheOnly" Content="Tryb Cache-only (nic nie wychodzi do internetu)" Foreground="White"
                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
            <CheckBox x:Name="ChkPrivate" Content="Tryb prywatny (bez zapisu na dysku)" Foreground="White" Margin="18,0,0,0"
                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnTranslateRegion"
                    Content="🖱  Przetłumacz region  (Ctrl+Shift+T)"
                    Click="OnTranslateRegionClick"
                    FontSize="14"
                    Padding="16,9"
                    Background="#FF1E88E5"
                    Foreground="White" />
            <Button x:Name="BtnToggleOverlay"
                    Content="Ukryj / pokaż nakładkę  (Ctrl+Shift+H)"
                    Click="OnToggleOverlayClick"
                    Margin="10,0,0,0"
                    Padding="12,9" />
          </StackPanel>

          <GroupBox Header="Tryb live (automatyczne tłumaczenie ekranu)" Foreground="White" Margin="0,12,0,0" Padding="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStartLive" Content="▶ Start live" Click="OnStartLiveClick" Padding="12,6" />
                <Button x:Name="BtnStopLive" Content="⏹ Stop" Click="OnStopLiveClick" IsEnabled="False" Margin="8,0,0,0" Padding="12,6" />
                <TextBlock Text="Wyświetlanie:" VerticalAlignment="Center" Margin="18,0,6,0" />
                <ComboBox x:Name="CmbLiveStyle" Width="170" SelectionChanged="OnSettingChanged" />
              </StackPanel>
              <TextBlock x:Name="TxtLiveStatus"
                         Foreground="#FF90A4AE"
                         FontSize="12"
                         Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Text="Wybierz okno gry z listy i kliknij Start — nowy tekst będzie tłumaczony automatycznie." />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Dane i słownik" Foreground="White" Margin="0,12,0,0" Padding="8">
            <StackPanel Orientation="Horizontal">
              <Button Content="📖 Słownik…" Click="OnOpenGlossaryEditorClick" />
              <Button Content="Wyczyść cache" Click="OnClearCacheClick" Margin="8,0,0,0" />
              <Button Content="Eksport cache…" Click="OnExportCacheClick" Margin="8,0,0,0" />
              <Button Content="Import cache…" Click="OnImportCacheClick" Margin="8,0,0,0" />
              <Button Content="Folder danych" Click="OnOpenDataFolderClick" Margin="8,0,0,0" />
              <Button Content="ⓘ Zastrzeżenie" Click="OnDisclaimerClick" Margin="8,0,0,0" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Ostatni wynik" Foreground="White" Margin="0,12,0,0" Padding="8">
            <StackPanel>
              <TextBlock Text="Rozpoznany tekst:" Foreground="#FF90A4AE" FontSize="11" />
              <TextBox x:Name="TxtLastOcr"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       Height="92"
                       Background="#FF0E1114"
                       Foreground="White"
                       BorderThickness="0"
                       Margin="0,3,0,0" />
              <TextBlock Text="Tłumaczenie:" Foreground="#FF90A4AE" FontSize="11" Margin="0,8,0,0" />
              <TextBox x:Name="TxtLastTranslation"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       Height="92"
                       Background="#FF0E1114"
                       Foreground="White"
                       BorderThickness="0"
                       Margin="0,3,0,0" />
            </StackPanel>
          </GroupBox>

          <TextBlock x:Name="TxtOcrStatus" Margin="0,10,0,0" Foreground="#FF90A4AE" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="TxtCacheStatus" Foreground="#FF90A4AE" FontSize="12" Margin="0,3,0,0" />
          <TextBlock x:Name="TxtTiming" Foreground="#FF90A4AE" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
