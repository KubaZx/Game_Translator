<Window x:Class="GameTranslatorOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui"
        Title="GameTranslatorOverlay"
        Width="1180"
        Height="800"
        MinWidth="920"
        MinHeight="640"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.WindowBg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        ui:WindowTheme.DarkFrame="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0,0,0,1"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <LinearGradientBrush x:Key="Brush.MiniScene" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF223258" Offset="0" />
      <GradientStop Color="#FF152238" Offset="0.62" />
      <GradientStop Color="#FF0D2A33" Offset="0.63" />
      <GradientStop Color="#FF081A20" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.MiniOriginal" Color="#FFEDE6D6" />
    <SolidColorBrush x:Key="Brush.MiniTranslated" Color="#FFC9BCFF" />
    <SolidColorBrush x:Key="Brush.MiniTranslated2" Color="#FF8BE3F5" />

    <Style x:Key="Mini.Frame" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{StaticResource Brush.MiniScene}" />
      <Setter Property="BorderBrush" Value="#FF2A3242" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="92" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style x:Key="Mini.Bar" TargetType="Rectangle">
      <Setter Property="Height" Value="5" />
      <Setter Property="RadiusX" Value="2.5" />
      <Setter Property="RadiusY" Value="2.5" />
      <Setter Property="Fill" Value="{StaticResource Brush.MiniOriginal}" />
    </Style>
    <Style x:Key="Option.Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Margin" Value="2,12,24,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Option.Description" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
      <Setter Property="Margin" Value="2,3,2,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style x:Key="Item.Option" TargetType="ListBoxItem" BasedOn="{StaticResource Item.Card}">
      <Setter Property="Padding" Value="10,10,10,12" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="Item.Provider" TargetType="ListBoxItem" BasedOn="{StaticResource Item.Card}">
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
      <Setter Property="Padding" Value="14,13,14,13" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="Item.Window" TargetType="ListBoxItem" BasedOn="{StaticResource Item.Card}">
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
    </Style>
    <Style x:Key="Field.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,7,0,0" />
    </Style>
    <Style x:Key="Field.ReadOnly" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Brush.SurfaceDeep}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Live.Halo" TargetType="Ellipse">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Tag, ElementName=LiveIndicator}" Value="Active" />
            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions>
            <BeginStoryboard x:Name="Pulse">
              <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.75" To="0" Duration="0:0:1.6" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.8" Duration="0:0:1.6" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.8" Duration="0:0:1.6" />
              </Storyboard>
            </BeginStoryboard>
          </MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Pulse" />
          </MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="WindowCard">
      <Grid Margin="0,0,26,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="{Binding ProcessName, Converter={StaticResource AvatarBrush}}">
          <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}" FontSize="17" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                     TextWrapping="Wrap" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="38" />
          <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProviderCard">
      <Grid Margin="0,0,22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconBadge}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Id, Converter={StaticResource ProviderGlyph}}" Style="{StaticResource Text.Icon}" FontSize="15"
                     Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Id, Converter={StaticResource ProviderTagline}}" Foreground="{StaticResource Brush.TextMuted}"
                     FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlacementOption">
      <StackPanel>
        <Grid>
          <Border x:Name="Below" Style="{StaticResource Mini.Frame}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Rectangle Canvas.Left="30" Canvas.Top="18" Width="96" Style="{StaticResource Mini.Bar}" />
              <Rectangle Canvas.Left="30" Canvas.Top="28" Width="62" Style="{StaticResource Mini.Bar}" />
              <Border Canvas.Left="22" Canvas.Top="42" Width="114" Height="30" CornerRadius="6" Background="#E60B0D12"
                      BorderBrush="#557C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="31" Canvas.Top="50" Width="90" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="31" Canvas.Top="60" Width="56" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated2}" />
            </Canvas>
            </Viewbox>
          </Border>
          <Border x:Name="Cover" Style="{StaticResource Mini.Frame}" Visibility="Collapsed">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Rectangle Canvas.Left="30" Canvas.Top="30" Width="96" Style="{StaticResource Mini.Bar}" Opacity="0.25" />
              <Border Canvas.Left="24" Canvas.Top="24" Width="110" Height="30" CornerRadius="4" Background="#FF1E2C4F"
                      BorderBrush="#88C9BCFF" BorderThickness="1" />
              <Rectangle Canvas.Left="31" Canvas.Top="31" Width="92" Style="{StaticResource Mini.Bar}" />
              <Rectangle Canvas.Left="31" Canvas.Top="41" Width="58" Style="{StaticResource Mini.Bar}" />
              <Rectangle Canvas.Left="44" Canvas.Top="70" Width="70" Style="{StaticResource Mini.Bar}" Opacity="0.5" />
            </Canvas>
            </Viewbox>
          </Border>
        </Grid>
        <TextBlock Text="{Binding}" Style="{StaticResource Option.Label}" />
        <TextBlock x:Name="Description" Style="{StaticResource Option.Description}"
                   Text="Tłumaczenie w dymku pod tekstem gry — oryginał zostaje widoczny." />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="1">
          <Setter TargetName="Below" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
          <Setter TargetName="Description" Property="Text" Value="Tłumaczenie w miejscu napisu gry — litery oryginału znikają pod łatką w kolorach tła." />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="LiveStyleOption">
      <StackPanel>
        <Grid>
          <Border x:Name="AtSource" Style="{StaticResource Mini.Frame}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Ellipse Canvas.Left="20" Canvas.Top="40" Width="16" Height="16" Fill="#FF33456E" />
              <Rectangle Canvas.Left="22" Canvas.Top="56" Width="12" Height="20" RadiusX="3" RadiusY="3" Fill="#FF33456E" />
              <Border Canvas.Left="40" Canvas.Top="20" Width="64" Height="24" CornerRadius="5" Background="#E60B0D12"
                      BorderBrush="#557C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="46" Canvas.Top="27" Width="50" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="46" Canvas.Top="35" Width="30" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated2}" />
              <Rectangle Canvas.Left="112" Canvas.Top="44" Width="34" Height="24" RadiusX="3" RadiusY="3" Fill="#FF5B4630" />
              <Border Canvas.Left="104" Canvas.Top="14" Width="48" Height="20" CornerRadius="5" Background="#E60B0D12"
                      BorderBrush="#557C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="110" Canvas.Top="21" Width="34" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
            </Canvas>
            </Viewbox>
          </Border>
          <Border x:Name="Subtitle" Style="{StaticResource Mini.Frame}" Visibility="Collapsed">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Ellipse Canvas.Left="20" Canvas.Top="30" Width="16" Height="16" Fill="#FF33456E" />
              <Rectangle Canvas.Left="22" Canvas.Top="46" Width="12" Height="20" RadiusX="3" RadiusY="3" Fill="#FF33456E" />
              <Rectangle Canvas.Left="112" Canvas.Top="34" Width="34" Height="24" RadiusX="3" RadiusY="3" Fill="#FF5B4630" />
              <Border Canvas.Left="26" Canvas.Top="64" Width="106" Height="20" CornerRadius="5" Background="#E60B0D12"
                      BorderBrush="#557C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="38" Canvas.Top="68" Width="82" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="52" Canvas.Top="76" Width="54" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated2}" />
            </Canvas>
            </Viewbox>
          </Border>
        </Grid>
        <TextBlock Text="{Binding}" Style="{StaticResource Option.Label}" />
        <TextBlock x:Name="Description" Style="{StaticResource Option.Description}"
                   Text="Każdy napis tłumaczony w miejscu, w którym pojawił się w grze." />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="1">
          <Setter TargetName="AtSource" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Subtitle" Property="Visibility" Value="Visible" />
          <Setter TargetName="Description" Property="Text" Value="Wszystkie tłumaczenia w jednym pasku napisów na dole okna gry." />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="BackgroundOption">
      <StackPanel>
        <Border Style="{StaticResource Mini.Frame}">
          <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
            <Rectangle Canvas.Left="18" Canvas.Top="16" Width="40" Height="40" RadiusX="20" RadiusY="20" Fill="#FF3B5B9A" Opacity="0.7" />
            <Rectangle Canvas.Left="100" Canvas.Top="12" Width="36" Height="52" RadiusX="4" RadiusY="4" Fill="#FF6B4A2E" Opacity="0.8" />
            <Border x:Name="Bubble" Canvas.Left="22" Canvas.Top="30" Width="114" Height="32" CornerRadius="6" Background="#D90B0D12"
                    BorderBrush="#447C5CFF" BorderThickness="1" />
            <Rectangle x:Name="LineA" Canvas.Left="31" Canvas.Top="38" Width="92" Style="{StaticResource Mini.Bar}" />
            <Rectangle x:Name="LineB" Canvas.Left="31" Canvas.Top="48" Width="58" Style="{StaticResource Mini.Bar}" />
          </Canvas>
            </Viewbox>
        </Border>
        <TextBlock Text="{Binding}" Style="{StaticResource Option.Label}" />
        <TextBlock x:Name="Description" Style="{StaticResource Option.Description}" Text="Wyraźny ciemny dymek — najlepsza czytelność." />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="1">
          <Setter TargetName="Bubble" Property="Background" Value="#660B0D12" />
          <Setter TargetName="Description" Property="Text" Value="Półprzezroczysty dymek — scena prześwituje." />
        </DataTrigger>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="2">
          <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="LineA" Property="Stroke" Value="#CC000000" />
          <Setter TargetName="LineB" Property="Stroke" Value="#CC000000" />
          <Setter TargetName="Description" Property="Text" Value="Sam tekst tłumaczenia, bez tła dymka." />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="DisplayModeOption">
      <StackPanel>
        <Grid>
          <Border x:Name="Panel" Style="{StaticResource Mini.Frame}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Rectangle Canvas.Left="14" Canvas.Top="22" Width="78" Height="26" RadiusX="3" RadiusY="3" Stroke="#FF22D3EE"
                         StrokeThickness="1.2" StrokeDashArray="3 2" Fill="#1422D3EE" />
              <Rectangle Canvas.Left="20" Canvas.Top="29" Width="60" Style="{StaticResource Mini.Bar}" />
              <Rectangle Canvas.Left="20" Canvas.Top="38" Width="40" Style="{StaticResource Mini.Bar}" />
              <Border Canvas.Left="100" Canvas.Top="14" Width="48" Height="62" CornerRadius="6" Background="#F2141821"
                      BorderBrush="#887C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="106" Canvas.Top="22" Width="30" Height="3" Style="{StaticResource Mini.Bar}" Opacity="0.5" />
              <Rectangle Canvas.Left="106" Canvas.Top="30" Width="36" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="106" Canvas.Top="38" Width="24" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="106" Canvas.Top="60" Width="14" Height="7" RadiusX="2" RadiusY="2" Fill="#FF2A3242" />
              <Rectangle Canvas.Left="123" Canvas.Top="60" Width="14" Height="7" RadiusX="2" RadiusY="2" Fill="#FF2A3242" />
            </Canvas>
            </Viewbox>
          </Border>
          <Border x:Name="Overlay" Style="{StaticResource Mini.Frame}" Visibility="Collapsed">
            <Viewbox Stretch="Uniform">
              <Canvas Width="160" Height="90">
              <Rectangle Canvas.Left="24" Canvas.Top="26" Width="110" Height="36" RadiusX="3" RadiusY="3" Stroke="#FF22D3EE"
                         StrokeThickness="1.2" StrokeDashArray="3 2" Fill="#1422D3EE" />
              <Border Canvas.Left="30" Canvas.Top="32" Width="98" Height="24" CornerRadius="5" Background="#E60B0D12"
                      BorderBrush="#557C5CFF" BorderThickness="1" />
              <Rectangle Canvas.Left="37" Canvas.Top="38" Width="78" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated}" />
              <Rectangle Canvas.Left="37" Canvas.Top="46" Width="48" Height="4" Style="{StaticResource Mini.Bar}" Fill="{StaticResource Brush.MiniTranslated2}" />
            </Canvas>
            </Viewbox>
          </Border>
        </Grid>
        <TextBlock Text="{Binding}" Style="{StaticResource Option.Label}" />
        <TextBlock x:Name="Description" Style="{StaticResource Option.Description}"
                   Text="Panel przy zaznaczeniu: oryginał, tłumaczenie, kopiowanie i poprawki." />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="1">
          <Setter TargetName="Panel" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
          <Setter TargetName="Description" Property="Text" Value="Tłumaczenie od razu w miejscu zaznaczonego tekstu." />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FontPreview">
      <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <ItemsPanelTemplate x:Key="TwoColumns">
      <UniformGrid Columns="2" Margin="0,0,-12,0" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ThreeColumns">
      <UniformGrid Columns="3" Margin="0,0,-12,0" />
    </ItemsPanelTemplate>
    <ui:WidthToColumnsConverter x:Key="ProviderColumnCount" Threshold="720" Narrow="2" Wide="3" />
    <ui:WidthToColumnsConverter x:Key="StatColumnCount" Threshold="720" Narrow="2" Wide="4" />
    <ui:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <ItemsPanelTemplate x:Key="ProviderColumns">
      <UniformGrid Margin="0,0,-10,0"
                   Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ProviderColumnCount}}" />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.08,0" GradientOrigin="0.08,0" RadiusX="0.55" RadiusY="0.7">
          <GradientStop Color="#1A7C5CFF" Offset="0" />
          <GradientStop Color="#007C5CFF" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
        <Image Source="{x:Static ui:AppLogo.Image}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Margin="11,0,0,1" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold">
          <Run Text="GameTranslator" /><Run Text="Overlay" Foreground="{StaticResource Brush.AccentHorizontal}" />
        </TextBlock>
      </StackPanel>

      <Border x:Name="LivePill" Grid.Column="1" Tag="Idle" Margin="18,0,0,0" VerticalAlignment="Center"
              CornerRadius="12" Padding="10,4,12,5" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Style.Triggers>
              <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="#1A34D399" />
                <Setter Property="BorderBrush" Value="#5534D399" />
              </Trigger>
              <Trigger Property="Tag" Value="Paused">
                <Setter Property="Background" Value="#1AFBBF24" />
                <Setter Property="BorderBrush" Value="#55FBBF24" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <Grid Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse Style="{StaticResource Live.Halo}" Fill="{Binding Fill, ElementName=LiveIndicator}" />
            <Ellipse Fill="{Binding Fill, ElementName=LiveIndicator}" />
          </Grid>
          <TextBlock x:Name="TxtLivePill" Text="Live wyłączony" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tag, ElementName=LivePill}" Value="Active">
                    <Setter Property="Foreground" Value="#FF6EE7B7" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tag, ElementName=LivePill}" Value="Paused">
                    <Setter Property="Foreground" Value="#FFFCD34D" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="BtnMinimize" Style="{StaticResource Btn.Caption}" ui:Visuals.Glyph="&#xE921;"
                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick"
                ToolTip="Minimalizuj do zasobnika" AutomationProperties.Name="Minimalizuj" />
        <Button x:Name="BtnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick"
                AutomationProperties.Name="Maksymalizuj">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
              <Setter Property="ui:Visuals.Glyph" Value="&#xE922;" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                  <Setter Property="ui:Visuals.Glyph" Value="&#xE923;" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource Btn.CaptionClose}" ui:Visuals.Glyph="&#xE8BB;"
                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" AutomationProperties.Name="Zamknij" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#FF161B24" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,10,14,16">
          <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="NavLiveHotkeyCard" Style="{StaticResource Card.Inset}" Padding="14,12" Background="#B30E1117">
              <StackPanel>
                <TextBlock Text="SKRÓT LIVE" Style="{StaticResource Text.Overline}" />
                <Border Style="{StaticResource Kbd}" Margin="0,8,0,0">
                  <TextBlock x:Name="TxtNavLiveHotkey" Text="Ctrl+Shift+L" />
                </Border>
                <TextBlock Text="Start i stop na aktywnej grze, bez przełączania się do tego okna." Style="{StaticResource Text.Hint}"
                           FontSize="11.5" LineHeight="16" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
              <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.TextFaint}" />
              <TextBlock Text="Nie ingeruje w grę ani jej proces." Foreground="{StaticResource Brush.TextFaint}" FontSize="11.5"
                         Margin="8,0,0,0" TextWrapping="Wrap" Width="170" />
            </StackPanel>
          </StackPanel>

          <StackPanel>
            <RadioButton x:Name="NavDashboard" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="Pulpit"
                         ui:Visuals.Glyph="&#xE80F;" IsChecked="True" />
            <RadioButton x:Name="NavGame" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="Gra"
                         ui:Visuals.Glyph="&#xE7FC;" />
            <RadioButton x:Name="NavTranslation" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="Tłumaczenie"
                         ui:Visuals.Glyph="&#xE8C1;" />
            <RadioButton x:Name="NavAppearance" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="Wygląd nakładki"
                         ui:Visuals.Glyph="&#xE790;" />
            <RadioButton x:Name="NavData" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="Dane i słownik"
                         ui:Visuals.Glyph="&#xE82D;" />
            <RadioButton x:Name="NavAbout" GroupName="Nawigacja" Style="{StaticResource Nav.Item}" Content="O programie"
                         ui:Visuals.Glyph="&#xE946;" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">

        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavDashboard, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                <TextBlock Text="&#xE80F;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Pulpit" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Wybierz grę, uruchom tryb live i miej wszystkie skróty pod ręką." Style="{StaticResource Text.PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,24,0,0">
              <Border CornerRadius="18" Background="{StaticResource Brush.HeroBg}" BorderBrush="{StaticResource Brush.HeroBorder}" BorderThickness="1" />
              <Border CornerRadius="18" IsHitTestVisible="False">
                <Border.Background>
                  <RadialGradientBrush Center="0.92,0.05" GradientOrigin="0.92,0.05" RadiusX="0.5" RadiusY="1.1">
                    <GradientStop Color="#2A22D3EE" Offset="0" />
                    <GradientStop Color="#0022D3EE" Offset="1" />
                  </RadialGradientBrush>
                </Border.Background>
              </Border>
              <Grid Margin="24,22,24,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="64" CornerRadius="16" VerticalAlignment="Center" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Background="{Binding SelectedItem.ProcessName, ElementName=WindowsList, Converter={StaticResource AvatarBrush}}">
                  <Grid>
                    <TextBlock Text="{Binding SelectedItem.Title, ElementName=WindowsList, Converter={StaticResource Initial}}" FontSize="28"
                               FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem, ElementName=WindowsList, Converter={StaticResource PresentToVisible}}" />
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" FontSize="26" Foreground="{StaticResource Brush.AccentText}"
                               HorizontalAlignment="Center"
                               Visibility="{Binding SelectedItem, ElementName=WindowsList, Converter={StaticResource MissingToVisible}}" />
                  </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                  <StackPanel Visibility="{Binding SelectedItem, ElementName=WindowsList, Converter={StaticResource PresentToVisible}}">
                    <TextBlock Text="WYBRANA GRA" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{Binding SelectedItem.Title, ElementName=WindowsList}" FontFamily="{StaticResource Font.Display}"
                               FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" LineHeight="27" LineStackingStrategy="BlockLineHeight" MaxHeight="56"
                               ToolTip="{Binding SelectedItem.Title, ElementName=WindowsList}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="&#xE7F4;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                      <TextBlock Text="{Binding SelectedItem.ProcessName, ElementName=WindowsList}" Foreground="{StaticResource Brush.TextMuted}"
                                 Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Visibility="{Binding SelectedItem, ElementName=WindowsList, Converter={StaticResource MissingToVisible}}">
                    <TextBlock Text="BRAK WYBRANEJ GRY" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="Wskaż okno gry" FontFamily="{StaticResource Font.Display}" FontSize="21" FontWeight="SemiBold"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Wybierz je w sekcji Gra albo w grze wciśnij skrót live — tłumacz sam znajdzie aktywne okno."
                               Style="{StaticResource Text.Hint}" Margin="0,5,0,0" />
                    <Button Content="Wybierz grę" ui:Visuals.Glyph="&#xE76C;" Style="{StaticResource Btn.Secondary}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnGoToGamePageClick" />
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Grid>
                    <Button x:Name="BtnStartLive" Content="Start live" Style="{StaticResource Btn.Hero}" ui:Visuals.Glyph="&#xE768;"
                            Click="OnStartLiveClick" />
                    <Button x:Name="BtnStopLive" Content="Stop live" Style="{StaticResource Btn.HeroStop}" ui:Visuals.Glyph="&#xE71A;"
                            Click="OnStopLiveClick" IsEnabled="False" />
                  </Grid>
                  <TextBlock x:Name="TxtLiveHotkeyHint" Text="albo Ctrl+Shift+L w grze" Style="{StaticResource Text.Status}" FontSize="11.5"
                             HorizontalAlignment="Center" Margin="0,9,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0" Padding="0,16,0,0" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="10" Height="10" VerticalAlignment="Top" Margin="2,4,12,0">
                      <Ellipse Style="{StaticResource Live.Halo}" Fill="{Binding Fill, ElementName=LiveIndicator}" />
                      <Ellipse x:Name="LiveIndicator" Fill="#FF5F6880" Tag="Idle" />
                    </Grid>
                    <TextBlock x:Name="TxtLiveStatus" Grid.Column="1" TextWrapping="Wrap" Foreground="#FFC3C9D6" LineHeight="19"
                               Text="Kliknij Start live — nowy tekst w oknie gry będzie tłumaczony automatycznie." />
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Szybkie przełączniki" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,16" />
                  <CheckBox x:Name="ChkCacheOnly" AutomationProperties.Name="Tryb Cache-only" Checked="OnSettingChanged" Unchecked="OnSettingChanged">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconBadge}">
                        <TextBlock Text="&#xE709;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Tryb Cache-only" FontWeight="SemiBold" />
                        <TextBlock Text="Nic nie wychodzi do internetu — tylko lokalne wyniki (cache, słownik)." Style="{StaticResource Text.Hint}" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </CheckBox>
                  <CheckBox x:Name="ChkPrivate" AutomationProperties.Name="Tryb prywatny" Margin="0,16,0,0" Checked="OnSettingChanged" Unchecked="OnSettingChanged">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconBadge}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Tryb prywatny" FontWeight="SemiBold" />
                        <TextBlock Text="Tłumaczenia i tekst z ekranu nie trafiają na dysk — cache tylko w pamięci." Style="{StaticResource Text.Hint}" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </CheckBox>
                  <CheckBox x:Name="ChkOverlayNotices" AutomationProperties.Name="Komunikaty w nakładce" Margin="0,16,0,0"
                            ToolTip="Krótkie ostrzeżenia nad grą — okno aplikacji jest w trakcie gry zwykle schowane."
                            Checked="OnOverlayNoticesChanged" Unchecked="OnOverlayNoticesChanged">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconBadge}">
                        <TextBlock Text="&#xE7E7;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Komunikaty w nakładce" FontWeight="SemiBold" />
                        <TextBlock Text="Brak klucza, limit, brak sieci, Cache-only, start i stop live — krótko nad grą." Style="{StaticResource Text.Hint}" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </CheckBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Szybkie akcje" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,16" />
                  <Button x:Name="BtnTranslateRegion" AutomationProperties.Name="Przetłumacz region" Style="{StaticResource Btn.Tile}" ui:Visuals.Glyph="&#xE7A8;"
                          ui:Visuals.Caption="Ctrl+Shift+T" Click="OnTranslateRegionClick">
                    <StackPanel>
                      <TextBlock Text="Przetłumacz region" TextWrapping="Wrap" />
                      <TextBlock Text="Zaznacz myszą fragment ekranu" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnToggleOverlay" AutomationProperties.Name="Ukryj albo pokaż nakładkę" Style="{StaticResource Btn.Tile}" ui:Visuals.Glyph="&#xE7B3;" Margin="0,10,0,0"
                          ui:Visuals.Caption="Ctrl+Shift+H" Click="OnToggleOverlayClick">
                    <StackPanel>
                      <TextBlock Text="Ukryj / pokaż nakładkę" TextWrapping="Wrap" />
                      <TextBlock Text="Chowa tłumaczenia nad grą bez zatrzymywania live" FontWeight="Normal" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel x:Name="PnlStats">
                <DockPanel Margin="0,0,0,14">
                  <TextBlock DockPanel.Dock="Right" Text="ta sesja" Foreground="{StaticResource Brush.TextFaint}" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="Statystyki" Style="{StaticResource Text.CardTitle}" />
                </DockPanel>
                <UniformGrid Margin="0,0,-10,-10"
                             Columns="{Binding ActualWidth, ElementName=PnlStats, Converter={StaticResource StatColumnCount}}">
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Zapytania API" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatApiRequests" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D2;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Znaki wysłane" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatApiChars" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock x:Name="TxtStatLatencyLabel" Text="Zmiana → napis" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatLatency" Text="—" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Z cache" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatCache" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE82D;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Ze słownika" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatGlossary" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Błędy" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatErrors" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border x:Name="TileQuality" Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12"
                          ToolTip="Różne tłumaczenia, które kontrola jakości oznaczyła w tej sesji (zmienione liczby, brak tłumaczenia, za długi wynik). Lista: Dane i słownik → Ostatnie ostrzeżenia.">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Ostrzeżenia jakości" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatQuality" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,0,10,10" Padding="14,12"
                          ToolTip="Drugie zapytania do modelu językowego, gdy pierwszy wynik nie przeszedł kontroli jakości — liczą się jak zwykłe zapytania.">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" />
                        <TextBlock Text="Ponowienia" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="8,0,0,0" />
                      </StackPanel>
                      <TextBlock x:Name="TxtStatRetries" Text="0" Style="{StaticResource Text.StatValue}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Ostatni wynik" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,14" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Rozpoznany tekst" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="TxtLastOcr" Style="{StaticResource TextBox.Area}" Height="118" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tłumaczenie" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="TxtLastTranslation" Style="{StaticResource TextBox.Area}" Height="118" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageGame" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavGame, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                <TextBlock Text="&#xE7FC;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Gra" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Wskaż okno gry. Tłumacz czyta tylko obraz okna — nie dotyka procesu gry." Style="{StaticResource Text.PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Center">
                      <TextBlock Text="&#xE7F4;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Uruchomione okna" Style="{StaticResource Text.CardTitle}" Margin="12,0,12,0" />
                    <Button x:Name="BtnRefresh" Grid.Column="2" Content="Odśwież" ui:Visuals.Glyph="&#xE72C;" VerticalAlignment="Center"
                            Click="OnRefreshClick" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Kliknij okno gry, a potem Start live na Pulpicie. Zapamiętana gra zaznacza się sama po odświeżeniu."
                               Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,12,0,0" />
                  </Grid>
                  <ListBox x:Name="WindowsList"
                           Style="{StaticResource List.Plain}"
                           TextSearch.TextPath="DisplayName"
                           ItemContainerStyle="{StaticResource Item.Window}"
                           ItemTemplate="{StaticResource WindowCard}"
                           SelectionChanged="OnWindowSelectionChanged" />
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <Border x:Name="CardGameProfile" Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE77B;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Profil tej gry" Style="{StaticResource Text.CardTitle}" />
                      <TextBlock Text="Rozpoznaje grę po nazwie procesu i włącza się sam." Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>

                  <TextBlock x:Name="TxtProfileNoWindow" Text="Wybierz okno z listy — pokażę, czy ta gra ma profil." Style="{StaticResource Text.Hint}" Margin="0,14,0,0" />

                  <StackPanel x:Name="PnlProfileMatched" Margin="0,14,0,0" Visibility="Collapsed">
                    <Border Style="{StaticResource Card.Inset}" Padding="14,12">
                      <StackPanel>
                        <DockPanel>
                          <Border x:Name="ChipProfileOwn" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="#1A7C5CFF" BorderBrush="#407C5CFF"
                                  Margin="10,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="własny" FontSize="11.5" Foreground="{StaticResource Brush.AccentText}" />
                          </Border>
                          <Border x:Name="ChipProfileBundled" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="z zestawu" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
                          </Border>
                          <TextBlock x:Name="TxtMatchedProfileName" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="TxtMatchedProfileDetail" Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,5,0,0" />
                        <TextBlock x:Name="TxtMatchedProfileActive" Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,3,0,0" />
                      </StackPanel>
                    </Border>
                    <WrapPanel x:Name="PnlOwnProfileActions" Margin="0,12,0,-8">
                      <Button x:Name="BtnRenameProfile" Content="Zmień nazwę" ui:Visuals.Glyph="&#xE8AC;" Click="OnRenameProfileClick" Margin="0,0,8,8" />
                      <Button x:Name="BtnDeleteProfile" Content="Usuń profil" Style="{StaticResource Btn.Danger}" ui:Visuals.Glyph="&#xE74D;"
                              Click="OnDeleteProfileClick" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel x:Name="PnlProfileRename" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="Nowa nazwa profilu" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="TxtRenameProfile" MaxLength="80" AutomationProperties.Name="Nowa nazwa profilu" KeyDown="OnProfileEditorKeyDown" />
                    <WrapPanel Margin="0,14,0,-8">
                      <Button x:Name="BtnSaveRename" Content="Zapisz nazwę" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE74E;"
                              Click="OnSaveRenameClick" Margin="0,0,8,8" />
                      <Button Content="Anuluj" Style="{StaticResource Btn.Ghost}" Click="OnCancelProfileEditClick" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel x:Name="PnlProfileMissing" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtProfileMissing" Style="{StaticResource Text.Hint}"
                               Text="Ta gra nie ma jeszcze profilu — tłumacz działa w trybie uniwersalnym. Własny profil zapamięta ją i włączy się sam przy jej oknie." />
                    <Button x:Name="BtnCreateProfile" Content="Utwórz profil dla tej gry" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE710;"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnCreateProfileClick" />
                  </StackPanel>

                  <StackPanel x:Name="PnlProfileCreate" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="Nazwa profilu" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="TxtNewProfileName" MaxLength="80" AutomationProperties.Name="Nazwa profilu" KeyDown="OnProfileEditorKeyDown" />
                    <TextBlock Text="Proces gry" Style="{StaticResource Text.Label}" Margin="0,14,0,7" />
                    <Border Style="{StaticResource Field.ReadOnly}">
                      <TextBlock x:Name="TxtNewProfileProcess" FontFamily="{StaticResource Font.Mono}" FontSize="12" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Foreground="#FFC3C9D6" />
                    </Border>
                    <TextBlock Text="Odczytany z okna — po nim profil rozpozna grę." Style="{StaticResource Field.Hint}" />
                    <TextBlock Text="Język gry" Style="{StaticResource Text.Label}" Margin="0,14,0,7" />
                    <ComboBox x:Name="CmbNewProfileLanguage" AutomationProperties.Name="Język gry w nowym profilu" />
                    <TextBlock x:Name="TxtNewProfileNote" Style="{StaticResource Field.Hint}" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,14,0,-8">
                      <Button x:Name="BtnSaveNewProfile" Content="Utwórz profil" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE74E;"
                              Click="OnSaveNewProfileClick" Margin="0,0,8,8" />
                      <Button Content="Anuluj" Style="{StaticResource Btn.Ghost}" Click="OnCancelProfileEditClick" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>

                  <TextBlock x:Name="TxtProfileEditError" Style="{StaticResource Text.Status}" Foreground="#FFFCA5A5" Margin="0,12,0,0" />
                  <TextBlock x:Name="TxtProfileLiveLock" Style="{StaticResource Text.Status}" Foreground="#FFFCD34D" Margin="0,12,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE722;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Podgląd i test OCR" Style="{StaticResource Text.CardTitle}" />
                      <TextBlock Text="Sprawdź, co widzi tłumacz. Obraz zostaje na tym komputerze." Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                  <Border Height="200" Margin="0,16,0,0" CornerRadius="12" Background="#FF07080C" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                      <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                  Visibility="{Binding Source, ElementName=PreviewImage, Converter={StaticResource MissingToVisible}}">
                        <TextBlock Text="&#xE722;" Style="{StaticResource Text.Icon}" FontSize="28" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center" />
                        <TextBlock Text="Brak podglądu" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="Wybierz okno z listy i kliknij „Podgląd okna”." Style="{StaticResource Text.Hint}" TextAlignment="Center" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnCapture" Content="Podgląd okna" ui:Visuals.Glyph="&#xE722;" Click="OnCaptureClick" Margin="0,0,8,8" />
                    <Button x:Name="BtnOcrTest" Content="Test OCR" ui:Visuals.Glyph="&#xE721;" Click="OnOcrTestClick" Margin="0,0,8,8" />
                  </WrapPanel>
                  <Border Style="{StaticResource Card.Inset}" Margin="0,6,0,0" Padding="12,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8D2;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.AccentText}" VerticalAlignment="Top" Margin="0,2,10,0" />
                      <TextBlock x:Name="TxtOcrStatus" Grid.Column="1" Style="{StaticResource Text.Hint}" Foreground="#FFC3C9D6" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageTranslation" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavTranslation, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                <TextBlock Text="&#xE8C1;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Tłumaczenie" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Języki, dostawca tłumaczeń z kluczem API, profil gry i postać gracza." Style="{StaticResource Text.PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Język gry" Style="{StaticResource Text.Label}" />
                  <ComboBox x:Name="CmbSourceLang" />
                </StackPanel>
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Margin="14,0,14,1" VerticalAlignment="Bottom"
                        Background="{StaticResource Brush.AccentSoft}" BorderBrush="#337C5CFF" BorderThickness="1">
                  <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Tłumacz na" Style="{StaticResource Text.Label}" />
                  <ComboBox x:Name="CmbTargetLang" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconBadge}">
                    <TextBlock Text="&#xE753;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dostawca tłumaczeń" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="Słownik i cache działają zawsze lokalnie; dostawca dostaje tylko nowy, rozpoznany tekst — nigdy obraz." Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
                <ListBox x:Name="CmbProvider"
                         Style="{StaticResource List.Plain}"
                         TextSearch.TextPath="DisplayName"
                         ItemsPanel="{StaticResource ProviderColumns}"
                         ItemContainerStyle="{StaticResource Item.Provider}"
                         ItemTemplate="{StaticResource ProviderCard}"
                         SelectionChanged="OnSettingChanged" />
              </StackPanel>
            </Border>

            <GroupBox x:Name="GrpProvider" Header="Dostawca tłumaczeń" Margin="0,16,0,0" ui:Visuals.Glyph="&#xE8D7;">
              <StackPanel>
                <StackPanel x:Name="PnlAzureSettings" Margin="0,0,0,16" Visibility="Collapsed">
                  <TextBlock Text="Region zasobu" Style="{StaticResource Text.Label}" />
                  <TextBox x:Name="TxtAzureRegion" MaxWidth="320" HorizontalAlignment="Left" Width="320" LostFocus="OnSettingChanged" />
                  <TextBlock Text="np. westeurope; puste = zasób globalny" Style="{StaticResource Field.Hint}" />
                </StackPanel>

                <StackPanel x:Name="PnlLlmSettings" Margin="0,0,0,16" Visibility="Collapsed">
                  <TextBlock Text="Adres serwera" Style="{StaticResource Text.Label}" />
                  <TextBox x:Name="TxtLlmEndpoint" LostFocus="OnSettingChanged" />
                  <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Gotowe:" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <StackPanel x:Name="PnlLlmPresets" Orientation="Horizontal" Margin="0,0,0,6" />
                  </WrapPanel>
                  <TextBlock Text="Model" Style="{StaticResource Text.Label}" Margin="0,10,0,7" />
                  <TextBox x:Name="TxtLlmModel" LostFocus="OnSettingChanged" />
                  <TextBlock Text="np. gpt-4.1-mini albo nazwa modelu z Ollamy" Style="{StaticResource Field.Hint}" />
                </StackPanel>

                <StackPanel x:Name="PnlClaudeSettings" Margin="0,0,0,16" Visibility="Collapsed">
                  <TextBlock Text="Model" Style="{StaticResource Text.Label}" />
                  <ComboBox x:Name="CmbClaudeModel" IsEditable="True" IsTextSearchEnabled="False" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                            LostFocus="OnSettingChanged" DropDownClosed="OnClaudeModelDropDownClosed" />
                  <TextBlock Text="Wybierz z listy albo wpisz nazwę modelu." Style="{StaticResource Field.Hint}" />
                </StackPanel>

                <CheckBox x:Name="ChkStreamLlm" AutomationProperties.Name="Pierwsze linie od razu" Margin="0,0,0,16" Visibility="Collapsed"
                          ToolTip="Odpowiedź modelu przychodzi strumieniem: w trybie live gotowe linie trafiają nad grę, zanim model skończy całą odpowiedź."
                          Checked="OnStreamLlmChanged" Unchecked="OnStreamLlmChanged">
                  <StackPanel>
                    <TextBlock Text="Pierwsze linie od razu" FontWeight="SemiBold" />
                    <TextBlock Text="Tryb live pokazuje gotowe linie, zanim model skończy odpowiedź. Ten sam koszt; wynik końcowy i tak je sprawdza."
                               Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </CheckBox>

                <TextBlock Text="Klucz API" Style="{StaticResource Text.Label}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="PwdApiKey" />
                  <Button x:Name="BtnSaveKey" Grid.Column="1" Content="Zapisz klucz" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE74E;"
                          Click="OnSaveKeyClick" Margin="10,0,0,0" />
                  <Button Grid.Column="2" Content="Testuj" ui:Visuals.Glyph="&#xE9D9;" Click="OnTestKeyClick" Margin="8,0,0,0" />
                  <Button x:Name="BtnDeleteKey" Grid.Column="3" Content="Usuń" Style="{StaticResource Btn.Danger}" ui:Visuals.Glyph="&#xE74D;"
                          Click="OnDeleteKeyClick" Margin="8,0,0,0" />
                </Grid>
                <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0" Padding="12,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8D7;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.AccentText}" VerticalAlignment="Top" Margin="0,2,10,0" />
                      <TextBlock x:Name="TxtKeyStatus" Grid.Column="1" Style="{StaticResource Text.Hint}" Foreground="#FFC3C9D6" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Top" Margin="0,2,10,0" />
                      <TextBlock x:Name="TxtProviderHint" Grid.Column="1" Style="{StaticResource Text.Hint}" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </GroupBox>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Profil gry" Style="{StaticResource Text.Label}" />
                  <ComboBox x:Name="CmbProfile" SelectionChanged="OnSettingChanged" />
                  <TextBlock Text="Bez profilu albo z profilem innej gry dobiera się sam po nazwie procesu; własny profil bez nazw procesów zostaje. Profil dla nowej gry utworzysz w sekcji Gra." Style="{StaticResource Field.Hint}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Postać gracza" Style="{StaticResource Text.Label}"
                             ToolTip="Modele językowe (Claude, serwer zgodny z OpenAI) odmieniają zwroty do gracza według płci postaci (zrobiłeś / zrobiłaś)." />
                  <ComboBox x:Name="CmbPlayerGender" SelectionChanged="OnSettingChanged" />
                  <TextBlock Text="Modele językowe odmieniają zwroty do gracza (zrobiłeś / zrobiłaś)." Style="{StaticResource Field.Hint}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                <TextBlock Text="&#xE790;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Wygląd nakładki" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Jak tłumaczenie wygląda nad grą. Zmiany działają od razu, bez przerywania tłumaczeń." Style="{StaticResource Text.PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
              <StackPanel>
                <TextBlock Text="Położenie dymków" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="Dotyczy tłumaczenia przy oryginale — w trybie live i po ręcznym zaznaczeniu." Style="{StaticResource Text.Hint}" Margin="0,3,0,14" />
                <ListBox x:Name="CmbPlacement" Style="{StaticResource List.Plain}" AlternationCount="2"
                         ItemsPanel="{StaticResource TwoColumns}" ItemContainerStyle="{StaticResource Item.Option}"
                         ItemTemplate="{StaticResource PlacementOption}" SelectionChanged="OnSettingChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Wyświetlanie w trybie live" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="Gdzie pojawiają się tłumaczenia, gdy tryb live sam śledzi tekst w grze." Style="{StaticResource Text.Hint}" Margin="0,3,0,14" />
                <ListBox x:Name="CmbLiveStyle" Style="{StaticResource List.Plain}" AlternationCount="2"
                         ItemsPanel="{StaticResource TwoColumns}" ItemContainerStyle="{StaticResource Item.Option}"
                         ItemTemplate="{StaticResource LiveStyleOption}" SelectionChanged="OnSettingChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Tło dymków" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="Dymki pod oryginałem i pasek napisów; przy „Na oryginale” tylko zapasowa, rozmyta łatka." Style="{StaticResource Text.Hint}" Margin="0,3,0,14" />
                <ListBox x:Name="CmbBackground" Style="{StaticResource List.Plain}" AlternationCount="3"
                         ItemsPanel="{StaticResource ThreeColumns}" ItemContainerStyle="{StaticResource Item.Option}"
                         ItemTemplate="{StaticResource BackgroundOption}" SelectionChanged="OnSettingChanged" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <CheckBox x:Name="ChkQualityMarks" AutomationProperties.Name="Znacznik ostrzeżeń w nakładce"
                        Checked="OnQualityMarksChanged" Unchecked="OnQualityMarksChanged">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconBadge}" Background="#1AFBBF24" BorderBrush="#40FBBF24">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Znacznik ostrzeżeń w nakładce" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="Bursztynowy rożek w rogu dymka i paska napisów (przy samym tekście — kropka obok), gdy kontrola jakości ma wątpliwości: zmienione liczby, brak tłumaczenia, za długi wynik. Przy „Na oryginale (zakrywa)” nigdy — tam napis ma wyglądać jak w grze."
                               Style="{StaticResource Text.Hint}" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </CheckBox>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Czcionka napisów" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,14" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Krój czcionki" Style="{StaticResource Text.Label}" />
                    <ComboBox x:Name="CmbFont" ItemTemplate="{StaticResource FontPreview}" SelectionChanged="OnSettingChanged" />
                    <TextBlock Text="„Jak w grze” bierze krój z profilu gry." Style="{StaticResource Field.Hint}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Rozmiar czcionki" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="TxtFontSize" LostFocus="OnSettingChanged" />
                    <TextBlock Text="0 = jak oryginał, albo 9–48; przy „Na oryginale” rozmiar wynika z gry." Style="{StaticResource Field.Hint}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <DockPanel>
                  <Border x:Name="KbdHotkeyResult" DockPanel.Dock="Right" Style="{StaticResource Kbd}">
                    <TextBlock x:Name="TxtHotkeyResult" Text="Ctrl+Shift+T" />
                  </Border>
                  <TextBlock Text="Wyświetlanie wyniku" Style="{StaticResource Text.CardTitle}" />
                </DockPanel>
                <TextBlock Text="Co pokazać po ręcznym zaznaczeniu regionu myszą." Style="{StaticResource Text.Hint}" Margin="0,3,0,14" />
                <ListBox x:Name="CmbDisplayMode" Style="{StaticResource List.Plain}" AlternationCount="2"
                         ItemsPanel="{StaticResource TwoColumns}" ItemContainerStyle="{StaticResource Item.Option}"
                         ItemTemplate="{StaticResource DisplayModeOption}" SelectionChanged="OnSettingChanged" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageData" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavData, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                <TextBlock Text="&#xE82D;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Dane i słownik" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Twój słownik, cache tłumaczeń, ostrzeżenia jakości, pomiary szybkości i folder z danymi aplikacji." Style="{StaticResource Text.PageSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE82D;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Słownik użytkownika" Style="{StaticResource Text.CardTitle}" Margin="12,0,0,0" />
                  </Grid>
                  <Button DockPanel.Dock="Bottom" Content="Słownik…" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE82D;"
                          HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnOpenGlossaryEditorClick" />
                  <TextBlock Text="Twoje terminy tłumaczą całą dopasowaną frazę lokalnie, bez API, i mają pierwszeństwo przed tłumaczeniem online."
                             Style="{StaticResource Text.Hint}" Margin="0,12,0,0" />
                </DockPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Cache tłumaczeń" Style="{StaticResource Text.CardTitle}" Margin="12,0,0,0" />
                  </Grid>
                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,-8">
                    <Button Content="Eksport…" ui:Visuals.Glyph="&#xEDE1;" Click="OnExportCacheClick" Margin="0,0,8,8" />
                    <Button Content="Import…" ui:Visuals.Glyph="&#xE8B5;" Click="OnImportCacheClick" Margin="0,0,8,8" />
                    <Button Content="Wyczyść" Style="{StaticResource Btn.Danger}" ui:Visuals.Glyph="&#xE74D;" Click="OnClearCacheClick" Margin="0,0,8,8" />
                  </WrapPanel>
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="TxtCacheStatus" Style="{StaticResource Text.Status}" Foreground="#FFC3C9D6" />
                    <TextBlock Text="Statystyki bazy pojawią się po kilku sekundach; w trybie prywatnym nie są odczytywane."
                               Style="{StaticResource Text.Hint}"
                               Visibility="{Binding Text, ElementName=TxtCacheStatus, Converter={StaticResource MissingToVisible}}" />
                    <TextBlock Text="Czyszczenie usuwa wpisy automatyczne — ręczne korekty zostają." Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>

            <Border x:Name="CardQualityWarnings" Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconBadge}" Background="#1AFBBF24" BorderBrush="#40FBBF24">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Ostatnie ostrzeżenia" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock x:Name="TxtQualityWarningsSummary" Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0"
                               Text="Do 20 ostatnich tłumaczeń, które kontrola jakości oznaczyła w tej sesji — tylko w pamięci, nic nie trafia na dysk." />
                  </StackPanel>
                  <Button x:Name="BtnClearQualityWarnings" Grid.Column="2" Content="Wyczyść" Style="{StaticResource Btn.Ghost}" ui:Visuals.Glyph="&#xE74D;"
                          VerticalAlignment="Top" IsEnabled="False" Click="OnClearQualityWarningsClick"
                          ToolTip="Czyści listę; licznik ostrzeżeń sesji na Pulpicie zostaje." />
                </Grid>
                <Border x:Name="PnlQualityWarningsEmpty" Style="{StaticResource Card.Inset}" Margin="0,16,0,0" Padding="14,12">
                  <TextBlock x:Name="TxtQualityWarningsEmpty" Style="{StaticResource Text.Hint}"
                             Text="Brak ostrzeżeń. Gdy tłumaczenie zgubi liczbę z oryginału, zostanie po angielsku albo będzie podejrzanie długie, pojawi się tutaj — z przyciskiem „Popraw”." />
                </Border>
                <ItemsControl x:Name="ListQualityWarnings" Margin="0,16,0,-8" Visibility="Collapsed">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card.Inset}" Padding="14,11" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <WrapPanel>
                              <Border Background="#1AFBBF24" BorderBrush="#55FBBF24" BorderThickness="1" CornerRadius="9" Padding="7,2,9,3"
                                      Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Hint}" ToolTipService.InitialShowDelay="200">
                                <TextBlock FontSize="11.5" Foreground="#FFFCD34D">
                                  <Run Text="⚠ " /><Run Text="{Binding Reason, Mode=OneWay}" />
                                </TextBlock>
                              </Border>
                              <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Padding="8,2,9,2"
                                      Visibility="{Binding IsCorrected, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="Poprawione ✔" Foreground="{StaticResource Brush.AccentText}" FontSize="11" />
                              </Border>
                              <TextBlock Text="{Binding Time}" Foreground="{StaticResource Brush.TextFaint}" FontSize="11.5" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding TranslatedText}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" FontSize="14.5"
                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}" />
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" Padding="10,8" Margin="0,8,0,0"
                                     AutomationProperties.Name="Poprawione tłumaczenie"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                     IsVisibleChanged="OnQualityEditBoxVisibleChanged" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="Popraw" Style="{StaticResource Btn.Chip}" ui:Visuals.Glyph="&#xE70F;" Margin="0"
                                    ToolTip="Własne tłumaczenie tego tekstu — ta sama ręczna poprawka co w panelu wyniku."
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}"
                                    Click="OnEditQualityWarningClick" />
                            <Button Content="Zapisz" Style="{StaticResource Btn.Chip}" ui:Visuals.Glyph="&#xE74E;"
                                    Background="{StaticResource Brush.Accent}" BorderBrush="#33FFFFFF" Foreground="White"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                    Click="OnSaveQualityWarningClick" />
                            <Button Content="Anuluj" Style="{StaticResource Btn.Chip}" Margin="0"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}"
                                    Click="OnCancelQualityWarningClick" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconBadge}">
                    <TextBlock Text="&#xE916;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Szybkość" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="Mediana z tej sesji — same liczby, bez tekstu z gry." Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Kopiuj raport" ui:Visuals.Glyph="&#xE8C8;" Click="OnCopyLatencyReportClick" />
                    <Button Content="Wyzeruj" Style="{StaticResource Btn.Ghost}" ui:Visuals.Glyph="&#xE72C;" Click="OnResetLatencyClick" Margin="6,0,0,0" />
                  </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card.Inset}" Margin="0,16,0,0" Padding="14,12">
                  <TextBlock x:Name="TxtLatency" Style="{StaticResource Text.Hint}" Foreground="#FFC3C9D6" FontSize="13" LineHeight="20"
                             Text="Brak pomiarów — przetłumacz coś albo uruchom live." />
                </Border>
                <TextBlock Text="Ostatnie tłumaczenie regionu" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                <TextBlock x:Name="TxtTiming" Style="{StaticResource Text.Status}" Foreground="#FFC3C9D6" />
                <TextBlock x:Name="TxtTimingHint" Text="Brak — przetłumacz region (Ctrl+Shift+T), żeby zobaczyć rozkład czasu."
                           Style="{StaticResource Text.Hint}"
                           Visibility="{Binding Text, ElementName=TxtTiming, Converter={StaticResource MissingToVisible}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadge}">
                  <TextBlock Text="&#xED25;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="Folder danych" Style="{StaticResource Text.CardTitle}" />
                  <TextBlock x:Name="TxtDataFolder" Style="{StaticResource Text.Status}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Margin="0,3,0,0" />
                  <TextBlock Text="Cache, ustawienia, słownik i logi." Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Otwórz folder" ui:Visuals.Glyph="&#xED25;" VerticalAlignment="Center" Click="OnOpenDataFolderClick" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVisible}}">
          <StackPanel Margin="36,26,30,36" MaxWidth="1120">
            <Grid>
              <Border CornerRadius="18" Background="{StaticResource Brush.HeroBg}" BorderBrush="{StaticResource Brush.HeroBorder}" BorderThickness="1" />
              <Grid Margin="26,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Static ui:AppLogo.Image}" Width="76" Height="76" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                  <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="GameTranslator" /><Run Text="Overlay" Foreground="{StaticResource Brush.AccentHorizontal}" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource Chip}" Margin="0">
                      <TextBlock x:Name="TxtVersion" Text="Wersja" FontSize="12" Foreground="{StaticResource Brush.Text}" />
                    </Border>
                    <TextBlock Text="tłumacz gier EN → PL na żywo" Foreground="{StaticResource Brush.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Windows OCR czyta tekst z okna gry, słownik i cache tłumaczą znane frazy lokalnie, a nowy tekst trafia do wybranego dostawcy. Wynik pokazuje zewnętrzna nakładka nad grą."
                             Style="{StaticResource Text.Hint}" FontSize="13" LineHeight="20" Margin="0,12,0,0" />
                </StackPanel>
              </Grid>
            </Grid>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Zastrzeżenie" Style="{StaticResource Text.CardTitle}" Margin="12,0,0,0" />
                  </Grid>
                  <Button DockPanel.Dock="Bottom" Content="Pełne zastrzeżenie" ui:Visuals.Glyph="&#xE946;" HorizontalAlignment="Left"
                          Margin="0,16,0,0" Click="OnDisclaimerClick" />
                  <TextBlock Text="Zewnętrzna nakładka — nie modyfikuje gry ani jej procesu, pamięci, plików ani ruchu sieciowego. Zasady gier i ich systemów anty-cheat się różnią: sprawdź regulamin swojej gry."
                             Style="{StaticResource Text.Hint}" Margin="0,12,0,0" />
                </DockPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}">
                      <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Prywatność" Style="{StaticResource Text.CardTitle}" Margin="12,0,0,0" />
                  </Grid>
                  <TextBlock Text="Przy tłumaczeniu online rozpoznany tekst trafia do wybranego dostawcy (DeepL, Azure, Google, Claude, serwer LLM); lokalny serwer LLM zostawia go na tym komputerze."
                             Style="{StaticResource Text.Hint}" Margin="0,12,0,0" />
                  <TextBlock Text="Do dostawcy nie trafia obraz. Klucze API szyfruje Windows (DPAPI), a tryb prywatny nie zapisuje na dysku tłumaczeń ani tekstu z ekranu (cache i pamięć dialogu tylko w RAM, logi bez treści)."
                             Style="{StaticResource Text.Hint}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconBadge}">
                    <TextBlock Text="&#xE765;" Style="{StaticResource Text.Icon}" FontSize="15" Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Skróty klawiszowe" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="Kliknij skrót i wciśnij nową kombinację — Esc anuluje. Trzy pierwsze działają globalnie, także gdy to okno jest schowane w zasobniku."
                               Style="{StaticResource Text.Hint}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button x:Name="BtnResetHotkeys" Grid.Column="2" Content="Przywróć domyślne" Style="{StaticResource Btn.Ghost}" ui:Visuals.Glyph="&#xE7A7;"
                          VerticalAlignment="Top" Click="OnResetHotkeysClick" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="194" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ToggleButton x:Name="BtnHotkeyTranslate" Grid.Row="0" Style="{StaticResource Btn.HotkeyField}" Margin="0,0,16,12" VerticalAlignment="Top"
                                AutomationProperties.Name="Skrót: przetłumacz region"
                                Checked="OnHotkeyFieldChecked" Unchecked="OnHotkeyFieldUnchecked" LostKeyboardFocus="OnHotkeyFieldLostFocus"
                                PreviewKeyDown="OnHotkeyFieldPreviewKeyDown" PreviewKeyUp="OnHotkeyFieldPreviewKeyUp">
                    <TextBlock x:Name="TxtHotkeyTranslate" Text="Ctrl+Shift+T" />
                  </ToggleButton>
                  <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,8,0,12">
                    <TextBlock Text="Zaznacz region ekranu i przetłumacz go" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtHotkeyTranslateNote" Style="{StaticResource Text.Status}" FontSize="12" Margin="0,3,0,0" />
                  </StackPanel>
                  <ToggleButton x:Name="BtnHotkeyLive" Grid.Row="1" Style="{StaticResource Btn.HotkeyField}" Margin="0,0,16,12" VerticalAlignment="Top"
                                AutomationProperties.Name="Skrót: start i stop trybu live"
                                Checked="OnHotkeyFieldChecked" Unchecked="OnHotkeyFieldUnchecked" LostKeyboardFocus="OnHotkeyFieldLostFocus"
                                PreviewKeyDown="OnHotkeyFieldPreviewKeyDown" PreviewKeyUp="OnHotkeyFieldPreviewKeyUp">
                    <TextBlock x:Name="TxtHotkeyLive" Text="Ctrl+Shift+L" />
                  </ToggleButton>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,12">
                    <TextBlock Text="Start / stop trybu live na aktywnej grze" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtHotkeyLiveNote" Style="{StaticResource Text.Status}" FontSize="12" Margin="0,3,0,0" />
                  </StackPanel>
                  <ToggleButton x:Name="BtnHotkeyOverlay" Grid.Row="2" Style="{StaticResource Btn.HotkeyField}" Margin="0,0,16,12" VerticalAlignment="Top"
                                AutomationProperties.Name="Skrót: ukryj albo pokaż nakładkę"
                                Checked="OnHotkeyFieldChecked" Unchecked="OnHotkeyFieldUnchecked" LostKeyboardFocus="OnHotkeyFieldLostFocus"
                                PreviewKeyDown="OnHotkeyFieldPreviewKeyDown" PreviewKeyUp="OnHotkeyFieldPreviewKeyUp">
                    <TextBlock x:Name="TxtHotkeyOverlay" Text="Ctrl+Shift+H" />
                  </ToggleButton>
                  <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,12">
                    <TextBlock Text="Ukryj albo pokaż nakładkę" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtHotkeyOverlayNote" Style="{StaticResource Text.Status}" FontSize="12" Margin="0,3,0,0" />
                  </StackPanel>
                  <Border Grid.Row="3" Style="{StaticResource Kbd}" Margin="0,0,16,0">
                    <TextBlock Text="Esc" />
                  </Border>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Anuluj zaznaczanie regionu (stały skrót)" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#E608090D" BorderBrush="#FF161B24" BorderThickness="0,1,0,0" Padding="18,9,14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.AccentText}" VerticalAlignment="Top" Margin="0,2,10,0" />
        <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Gotowy." TextWrapping="Wrap" Foreground="#FFC3C9D6" FontSize="12.5"
                   VerticalAlignment="Center" Margin="0,0,14,0" />
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="640">
          <Border Style="{StaticResource Chip}" Background="#1AFBBF24" BorderBrush="#40FBBF24" Margin="6,2,0,2"
                  Visibility="{Binding IsChecked, ElementName=ChkCacheOnly, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE709;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="#FFFCD34D" />
              <TextBlock Text="Cache-only" FontSize="11.5" Foreground="#FFFCD34D" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Background="#1A7C5CFF" BorderBrush="#407C5CFF" Margin="6,2,0,2"
                  Visibility="{Binding IsChecked, ElementName=ChkPrivate, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{StaticResource Brush.AccentText}" />
              <TextBlock Text="Prywatny" FontSize="11.5" Foreground="{StaticResource Brush.AccentText}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Margin="6,2,0,2" ToolTip="Zapytania do dostawcy i wysłane znaki w tej sesji">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE753;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBlock x:Name="TxtCounters" Text="API 0" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Margin="6,2,0,2" ToolTip="Teksty przetłumaczone z cache">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBlock x:Name="TxtChipCache" Text="Cache 0" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Margin="6,2,0,2" ToolTip="Teksty przetłumaczone ze słownika">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE82D;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
              <TextBlock x:Name="TxtChipGlossary" Text="Słownik 0" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="ChipErrors" Style="{StaticResource Chip}" Margin="6,2,0,2" ToolTip="Nieudane zapytania do dostawcy">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE783;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{Binding Foreground, ElementName=TxtChipErrors}" />
              <TextBlock x:Name="TxtChipErrors" Text="Błędy 0" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="ChipQuality" Style="{StaticResource Chip}" Margin="6,2,0,2"
                  ToolTip="Tłumaczenia z ostrzeżeniem kontroli jakości w tej sesji — lista w sekcji Dane i słownik">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{Binding Foreground, ElementName=TxtChipQuality}" />
              <TextBlock x:Name="TxtChipQuality" Text="Ostrzeżenia 0" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
