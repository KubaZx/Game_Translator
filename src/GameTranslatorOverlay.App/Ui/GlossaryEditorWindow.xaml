<Window x:Class="GameTranslatorOverlay.App.Ui.GlossaryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui"
        Title="Słownik użytkownika"
        Width="860"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        Background="{StaticResource Brush.WindowBg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        ui:WindowTheme.DarkFrame="True"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="24,20,24,20">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
        <TextBlock Text="&#xE82D;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="Słownik użytkownika" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="TxtHeader" Style="{StaticResource Text.Hint}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="Zapisz i zamknij" Style="{StaticResource Btn.Primary}" ui:Visuals.Glyph="&#xE74E;"
              Click="OnSaveClick" Margin="12,0,0,0" VerticalAlignment="Bottom" />
      <WrapPanel Margin="0,0,0,-8">
        <Button Content="Dodaj wiersz" ui:Visuals.Glyph="&#xE710;" Click="OnAddRowClick" Margin="0,0,8,8" />
        <Button Content="Usuń zaznaczone" Style="{StaticResource Btn.Danger}" ui:Visuals.Glyph="&#xE74D;" Click="OnDeleteRowClick" Margin="0,0,8,8" />
        <Button Content="Importuj JSON…" Style="{StaticResource Btn.Ghost}" ui:Visuals.Glyph="&#xE8B5;" Click="OnImportClick" Margin="0,0,4,8" />
        <Button Content="Eksportuj JSON…" Style="{StaticResource Btn.Ghost}" ui:Visuals.Glyph="&#xEDE1;" Click="OnExportClick" Margin="0,0,4,8" />
      </WrapPanel>
    </DockPanel>

    <TextBlock x:Name="TxtInfo"
               DockPanel.Dock="Bottom"
               Style="{StaticResource Text.Status}"
               Foreground="{StaticResource Brush.Warning}"
               FontSize="12.5"
               Margin="2,12,0,0" />

    <DataGrid x:Name="TermsGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Termin (język źródłowy)" Binding="{Binding Source}" Width="2*"
                            ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource DataGrid.EditingText}" />
        <DataGridTextColumn Header="Tłumaczenie" Binding="{Binding Target}" Width="2*"
                            ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource DataGrid.EditingText}" />
        <DataGridTextColumn Header="Priorytet" Binding="{Binding Priority}" Width="92"
                            ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource DataGrid.EditingText}" />
        <DataGridCheckBoxColumn Binding="{Binding CaseSensitive}" Width="56"
                                ElementStyle="{StaticResource DataGrid.CheckElement}" EditingElementStyle="{StaticResource DataGrid.CheckEditing}">
          <DataGridCheckBoxColumn.Header>
            <TextBlock Text="Aa" ToolTip="Rozróżniaj wielkość liter" />
          </DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
        <DataGridCheckBoxColumn Binding="{Binding LabelOnly}" Width="86"
                                ElementStyle="{StaticResource DataGrid.CheckElement}" EditingElementStyle="{StaticResource DataGrid.CheckEditing}">
          <DataGridCheckBoxColumn.Header>
            <TextBlock Text="Etykieta" ToolTip="Tylko cały tekst etykiety (przycisk, nagłówek) — nie w zdaniach ani w glosariuszu DeepL" />
          </DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
        <DataGridTextColumn Header="Notatka" Binding="{Binding Note}" Width="1.4*"
                            ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource DataGrid.EditingText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
