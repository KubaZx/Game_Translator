<Window x:Class="GameTranslatorOverlay.App.Ui.GlossaryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Słownik użytkownika"
        Width="700"
        Height="540"
        MinWidth="560"
        MinHeight="400"
        Background="#FF14181C"
        Foreground="White"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock x:Name="TxtHeader"
               DockPanel.Dock="Top"
               TextWrapping="Wrap"
               Foreground="#FF90A4AE"
               Margin="0,0,0,10" />

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="Dodaj wiersz" Click="OnAddRowClick" />
      <Button Content="Usuń zaznaczone" Click="OnDeleteRowClick" Margin="8,0,0,0" />
      <Button Content="Importuj JSON…" Click="OnImportClick" Margin="8,0,0,0" />
      <Button Content="Eksportuj JSON…" Click="OnExportClick" Margin="8,0,0,0" />
      <Button Content="Zapisz i zamknij" Click="OnSaveClick" Margin="16,0,0,0" Background="#FF1E88E5" />
    </StackPanel>

    <TextBlock x:Name="TxtInfo"
               DockPanel.Dock="Bottom"
               Foreground="#FFFFB74D"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,8,0,0" />

    <DataGrid x:Name="TermsGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              Background="#FF0E1114"
              RowBackground="White"
              AlternatingRowBackground="#FFEFF3F5"
              Foreground="Black"
              FontSize="13">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Termin (język źródłowy)" Binding="{Binding Source}" Width="2*" />
        <DataGridTextColumn Header="Tłumaczenie" Binding="{Binding Target}" Width="2*" />
        <DataGridTextColumn Header="Priorytet" Binding="{Binding Priority}" Width="70" />
        <DataGridCheckBoxColumn Header="Aa" Binding="{Binding CaseSensitive}" Width="40"
                                ToolTipService.ToolTip="Rozróżniaj wielkość liter" />
        <DataGridTextColumn Header="Notatka" Binding="{Binding Note}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
