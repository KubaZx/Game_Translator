<Window x:Class="GameTranslatorOverlay.App.Ui.SettingsNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.WindowBg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        ui:WindowTheme.DarkFrame="True"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="TxtTitle" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox x:Name="TxtMessage"
             Margin="0,12,0,0"
             Background="Transparent"
             BorderThickness="0"
             IsReadOnly="True"
             Foreground="{StaticResource Brush.Text}"
             TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnKeep" Margin="0,0,8,0" Click="OnKeepClick" />
      <Button x:Name="BtnDefaults" Style="{StaticResource Btn.Primary}" Click="OnDefaultsClick" />
    </StackPanel>
  </StackPanel>
</Window>
