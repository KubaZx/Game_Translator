<Window x:Class="GameTranslatorOverlay.App.Ui.ResultPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui"
        Title="Wynik tłumaczenia"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        MaxWidth="540"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
  </Window.Resources>
  <Grid>
    <Border CornerRadius="14" Background="#F5101319" BorderBrush="{StaticResource Brush.HeroBorder}" BorderThickness="1" />
    <Border CornerRadius="14" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="0.7" RadiusY="0.6">
          <GradientStop Color="#1F7C5CFF" Offset="0" />
          <GradientStop Color="#007C5CFF" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <StackPanel MinWidth="320" Margin="16,12,16,14">
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton x:Name="PinToggle"
                        ui:Visuals.Glyph="&#xE718;"
                        ToolTip="Przypnij panel (wyłącza auto-ukrywanie)"
                        AutomationProperties.Name="Przypnij panel"
                        Padding="8,0"
                        Margin="0"
                        Checked="OnPinChanged"
                        Unchecked="OnPinChanged" />
          <Button ui:Visuals.Glyph="&#xE8BB;"
                  Style="{StaticResource Btn.Chip}"
                  ToolTip="Zamknij"
                  AutomationProperties.Name="Zamknij"
                  Padding="8,0"
                  Margin="6,0,0,0"
                  Click="OnCloseClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{x:Static ui:AppLogo.Image}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Tłumaczenie" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                     Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
      <Border x:Name="WarningBox" Background="#14FBBF24" BorderBrush="#40FBBF24" BorderThickness="1" CornerRadius="9"
              Padding="10,7" Margin="0,0,0,10"
              Visibility="{Binding Visibility, ElementName=WarningText}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Brush.Warning}"
                     VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock x:Name="WarningText"
                     Grid.Column="1"
                     Foreground="#FFFCD34D"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </Grid>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
        <ItemsControl x:Name="ItemsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#99171B24" BorderBrush="#FF222938" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="{Binding SourceText}"
                             Foreground="{StaticResource Brush.TextMuted}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding TranslatedText}"
                             Foreground="White"
                             FontFamily="{StaticResource Font.Display}"
                             FontSize="16"
                             TextWrapping="Wrap"
                             Margin="0,3,0,0"
                             Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                  <Grid Margin="0,6,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="300"
                             MaxWidth="380"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="10,8"
                             Loaded="OnEditBoxLoaded" />
                    <Button Grid.Column="1"
                            Content="Zapisz"
                            Style="{StaticResource Btn.Primary}"
                            ui:Visuals.Glyph="&#xE74E;"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Click="OnSaveCorrectionClick" />
                  </Grid>
                  <DockPanel Margin="0,9,0,0">
                    <Border Style="{StaticResource Chip}" Margin="0,0,10,0" Padding="8,2,9,2">
                      <TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource Brush.AccentText}" FontSize="11" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Kopiuj" Style="{StaticResource Btn.Chip}" ui:Visuals.Glyph="&#xE8C8;" Click="OnCopyClick" />
                      <Button Content="Popraw" Style="{StaticResource Btn.Chip}" ui:Visuals.Glyph="&#xE70F;" Click="OnEditClick" />
                      <Button Content="Słownik" Style="{StaticResource Btn.Chip}" ui:Visuals.Glyph="&#xE710;" Click="OnAddTermClick"
                              ToolTip="Dodaj ten tekst i tłumaczenie do słownika" Margin="0" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
        <TextBlock Text="&#xE916;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{StaticResource Brush.TextFaint}" />
        <TextBlock x:Name="TimingText"
                   Foreground="{StaticResource Brush.TextFaint}"
                   FontSize="10.5"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
