<Window x:Class="GameTranslatorOverlay.App.Ui.ResultPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui"
        Title="Wynik tłumaczenia"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        MaxWidth="540"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
  </Window.Resources>
  <Border Background="#F2101418"
          BorderBrush="#334FC3F7"
          BorderThickness="1"
          CornerRadius="10"
          Padding="14">
    <StackPanel MinWidth="320">
      <TextBlock x:Name="WarningText"
                 Foreground="#FFFFB74D"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"
                 Margin="0,0,0,6" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
        <ItemsControl x:Name="ItemsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,10">
                <TextBlock Text="{Binding SourceText}"
                           Foreground="#FF8FA0A8"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding TranslatedText}"
                           Foreground="White"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                  <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                           MinWidth="300"
                           MaxWidth="380"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           Loaded="OnEditBoxLoaded" />
                  <Button Content="Zapisz"
                          Margin="6,0,0,0"
                          VerticalAlignment="Top"
                          Click="OnSaveCorrectionClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="{Binding OriginLabel}"
                             Foreground="#FF5E6D75"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                  <Button Content="Kopiuj" Click="OnCopyClick" FontSize="11" Padding="7,2" />
                  <Button Content="Popraw" Click="OnEditClick" FontSize="11" Padding="7,2" Margin="6,0,0,0" />
                  <Button Content="+ Słownik" Click="OnAddTermClick" FontSize="11" Padding="7,2" Margin="6,0,0,0" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <DockPanel Margin="0,8,0,0" LastChildFill="False">
        <TextBlock x:Name="TimingText"
                   Foreground="#FF5E6D75"
                   FontSize="10"
                   VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton x:Name="PinToggle"
                        Content="📌"
                        ToolTip="Przypnij panel (wyłącza auto-ukrywanie)"
                        FontSize="11"
                        Padding="7,2"
                        Checked="OnPinChanged"
                        Unchecked="OnPinChanged" />
          <Button Content="Zamknij" Click="OnCloseClick" FontSize="11" Padding="9,2" Margin="6,0,0,0" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
