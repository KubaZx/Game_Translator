<Window x:Class="GameTranslatorOverlay.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nakładka tłumaczenia"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
  <Grid>
    <Canvas x:Name="RootCanvas" />
    <!-- Komunikaty dla gracza: osobna warstwa, której nie czyści ClearBlocks. -->
    <Canvas x:Name="NoticeCanvas" IsHitTestVisible="False" />
  </Grid>
</Window>
