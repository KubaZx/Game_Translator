  <Style x:Key="List.Plain" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="ui:SelectionGuard.KeepSelected" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
