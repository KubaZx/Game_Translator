              <Setter TargetName="Bd" Property="Background" Value="#FF1A1F29" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
