<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GameTranslatorOverlay.App.Ui">

  <Color x:Key="Color.Surface">#FF12151C</Color>
  <Color x:Key="Color.Border">#FF1F2633</Color>
  <Color x:Key="Color.Text">#FFE8ECF4</Color>
  <Color x:Key="Color.TextMuted">#FF8B93A7</Color>
  <Color x:Key="Color.Accent">#FF7C5CFF</Color>
  <Color x:Key="Color.Accent2">#FF22D3EE</Color>
  <Color x:Key="Color.Success">#FF34D399</Color>
  <Color x:Key="Color.Warning">#FFFBBF24</Color>
  <Color x:Key="Color.Danger">#FFF87171</Color>

  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FF181C26" />
  <SolidColorBrush x:Key="Brush.SurfaceInset" Color="#FF0E1117" />
  <SolidColorBrush x:Key="Brush.SurfaceDeep" Color="#FF08090D" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF2A3242" />
  <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF3B4560" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextFaint" Color="#FF6B7489" />
  <SolidColorBrush x:Key="Brush.AccentSolid" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent2Solid" Color="{StaticResource Color.Accent2}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1F7C5CFF" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFB4A4FF" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1FF87171" />

  <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
    <GradientStop Color="{StaticResource Color.Accent2}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.AccentHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
    <GradientStop Color="{StaticResource Color.Accent2}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.AccentVertical" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
    <GradientStop Color="{StaticResource Color.Accent2}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0.6,1">
    <GradientStop Color="#FF0F121A" Offset="0" />
    <GradientStop Color="#FF0B0D12" Offset="0.55" />
    <GradientStop Color="#FF090A0E" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.HeroBg" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1B1740" Offset="0" />
    <GradientStop Color="#FF131A2C" Offset="0.55" />
    <GradientStop Color="#FF0F1820" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.HeroBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#667C5CFF" Offset="0" />
    <GradientStop Color="#2622D3EE" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <ui:BoolToVisibilityConverter x:Key="BoolToVisible" />
  <ui:NullToVisibilityConverter x:Key="PresentToVisible" />
  <ui:NullToVisibilityConverter x:Key="MissingToVisible" Invert="True" />
  <ui:InitialConverter x:Key="Initial" />
  <ui:AvatarBrushConverter x:Key="AvatarBrush" />
  <ui:ProviderPresentationConverter x:Key="ProviderGlyph" Glyph="True" />
  <ui:ProviderPresentationConverter x:Key="ProviderTagline" />

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
  </Style>
  <Style x:Key="Text.Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style x:Key="Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Text.Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Text.StatValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Card.Inset" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style x:Key="IconBadge" TargetType="Border">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
    <Setter Property="BorderBrush" Value="#337C5CFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="#FF11141B" />
    <Setter Property="BorderBrush" Value="#FF232A38" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="9,3,10,3" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Kbd" TargetType="Border">
    <Setter Property="Background" Value="#FF171B24" />
    <Setter Property="BorderBrush" Value="#FF303849" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2,7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="TextElement.FontSize" Value="11.5" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding ui:Visuals.CornerRadius}" />
      <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="{TemplateBinding ui:Visuals.CornerRadius}" />
      <StackPanel Orientation="Horizontal"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <TextBlock x:Name="Glyph"
                   Text="{TemplateBinding ui:Visuals.Glyph}"
                   FontFamily="{StaticResource Font.Icons}"
                   FontSize="{TemplateBinding ui:Visuals.GlyphSize}"
                   TextOptions.TextRenderingMode="Grayscale"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </StackPanel>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ui:Visuals.Glyph" Value="{x:Null}">
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Glyph" Property="Margin" Value="0" />
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.06" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Hover" Property="Opacity" Value="0.1" />
        <Setter TargetName="Root" Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Btn.Secondary" TargetType="ButtonBase">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Btn.Secondary}" />
  <Style x:Key="Btn.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Secondary}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Btn.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Secondary}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Btn.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Secondary}">
    <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
    <Setter Property="BorderBrush" Value="#55F87171" />
    <Setter Property="Foreground" Value="#FFFCA5A5" />
  </Style>
  <Style x:Key="Btn.Chip" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Secondary}">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="ui:Visuals.GlyphSize" Value="11" />
    <Setter Property="ui:Visuals.CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style x:Key="Btn.Hero" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
    <Setter Property="MinWidth" Value="196" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="26,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="ui:Visuals.GlyphSize" Value="15" />
    <Setter Property="ui:Visuals.CornerRadius" Value="14" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#FF7C5CFF" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Btn.HeroStop" TargetType="Button" BasedOn="{StaticResource Btn.Danger}">
    <Setter Property="MinWidth" Value="196" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="26,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="ui:Visuals.GlyphSize" Value="15" />
    <Setter Property="ui:Visuals.CornerRadius" Value="14" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#FFF87171" BlurRadius="26" ShadowDepth="0" Opacity="0.35" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Btn.Tile" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="ui:Visuals.CornerRadius" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{TemplateBinding ui:Visuals.CornerRadius}" />
            <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="{TemplateBinding ui:Visuals.CornerRadius}" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                <TextBlock Text="{TemplateBinding ui:Visuals.Glyph}" Style="{StaticResource Text.Icon}" FontSize="15"
                           Foreground="{StaticResource Brush.AccentText}" HorizontalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <ContentPresenter TextElement.FontWeight="SemiBold" />
                <Border x:Name="Shortcut" Style="{StaticResource Kbd}" Margin="0,8,0,0">
                  <TextBlock Text="{TemplateBinding ui:Visuals.Caption}" />
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ui:Visuals.Caption" Value="{x:Null}">
              <Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.04" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Caption" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <TextBlock Text="{TemplateBinding ui:Visuals.Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextOptions.TextRenderingMode="Grayscale" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF1C212C" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF242A37" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <TextBlock Text="{TemplateBinding ui:Visuals.Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextOptions.TextRenderingMode="Grayscale" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FFE5484D" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FFC93A3F" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToggleButton" BasedOn="{StaticResource Btn.Chip}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentSolid}" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Nav.Item" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HoverBg" CornerRadius="10" Background="#FF151922" Opacity="0" />
            <Border x:Name="ActiveBg" CornerRadius="10" Opacity="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#387C5CFF" Offset="0" />
                  <GradientStop Color="#0822D3EE" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{StaticResource Brush.AccentVertical}" Opacity="0" />
            <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
              <TextBlock x:Name="Icon" Text="{TemplateBinding ui:Visuals.Glyph}" Style="{StaticResource Text.Icon}" Width="20" />
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="HoverBg" Property="Opacity" Value="0" />
              <Setter TargetName="ActiveBg" Property="Opacity" Value="1" />
              <Setter TargetName="Bar" Property="Opacity" Value="1" />
              <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.AccentText}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="Content" VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True" />
            <Grid Grid.Column="1" Width="42" Height="24" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="12" Background="#FF222836" BorderBrush="#FF353E52" BorderThickness="1" />
              <Border x:Name="TrackOn" CornerRadius="12" Background="{StaticResource Brush.AccentHorizontal}" Opacity="0" />
              <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="#FF8B93A7">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Content" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="White" />
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

